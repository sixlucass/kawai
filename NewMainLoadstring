local currentTab

local function paintTab(name, hovered)
	local icon = tabButtons[name].Icon
	local active = name == currentTab
	local color = active and C.White or (hovered and C.Text or C.SubText)
	tween(icon, 0.15, { ImageColor3 = color })
	for _, child in ipairs(icon:GetChildren()) do
		if child:IsA("TextLabel") then
			child.TextColor3 = color
		end
	end
end

local function setTab(name)
	currentTab = name
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
	for tabName in pairs(tabButtons) do
		paintTab(tabName, false)
	end
end

local function makeTab(name, icon, order)
	local btn = new("TextButton", {
		Name = name,
		LayoutOrder = order,
		Size = UDim2.fromOffset(40, 40),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
	}, tabHolder)

	local img = makeIcon(btn, icon, 24, C.SubText, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	img.Name = "Icon"
	tabButtons[name] = btn

	btn.MouseEnter:Connect(function()
		paintTab(name, true)
	end)
	btn.MouseLeave:Connect(function()
		paintTab(name, false)
	end)
	btn.Activated:Connect(function()
		setTab(name)
	end)
end

