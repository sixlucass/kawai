			AutoButtonColor = false,
			Text = "",
		}, window)
		local icon = makeIcon(close, "x", 22, C.Text, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
		close.MouseEnter:Connect(function()
			tween(icon, 0.15, { ImageColor3 = C.Error })
		end)
		close.MouseLeave:Connect(function()
			tween(icon, 0.15, { ImageColor3 = C.Text })
		end)
		close.Activated:Connect(function()
			gui:Destroy()
		end)
	end

	new("Frame", {
		Position = UDim2.fromOffset(395, 92),
		Size = UDim2.fromOffset(1, 284),
		BackgroundColor3 = C.Line,
		BorderSizePixel = 0,
	}, window)

	local keyBox = new("TextBox", {
		Position = UDim2.fromOffset(22, 126),
		Size = UDim2.fromOffset(360, 54),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderText = "Enter your key...",
		PlaceholderColor3 = C.Sub,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 15,
	}, window)
	corner(keyBox, 14)

	local helper = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 196),
		Size = UDim2.fromOffset(360, 32),
		Font = Enum.Font.Gotham,
		Text = HELP_TEXT,
		TextColor3 = C.Sub,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, window)

	local function setStatus(text, color)
		helper.Text = text
		helper.TextColor3 = color or C.Sub
	end

	local function makeButton(text, position, size, filled)
		local btn = new("TextButton", {
			Position = position,
			Size = size,
			BackgroundColor3 = filled and C.Accent or C.Panel,
			AutoButtonColor = false,
			Font = Enum.Font.GothamBold,
			Text = text,
			TextColor3 = filled and C.Dark or C.Text,
			TextSize = 15,
		}, window)
		corner(btn, 14)
		local rest = filled and C.Accent or C.Panel
		local hover = filled and C.AccentHover or C.PanelHover
		btn.MouseEnter:Connect(function()
			tween(btn, 0.15, { BackgroundColor3 = hover })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, 0.15, { BackgroundColor3 = rest })
		end)
		return btn
	end

	local dropdown = makeButton("", UDim2.fromOffset(22, 240), UDim2.fromOffset(172, 54), false)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -50, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = "Get Key",
		TextColor3 = C.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, dropdown)
	local chevron = makeIcon(dropdown, "chevron-down", 18, C.Text, UDim2.new(1, -18, 0.5, 0), Vector2.new(1, 0.5))

	local redeem = makeButton("Redeem Key", UDim2.fromOffset(210, 240), UDim2.fromOffset(172, 54), true)

	local list = new("Frame", {
		Position = UDim2.fromOffset(22, 300),
		Size = UDim2.fromOffset(172, #PROVIDERS * 40 + 8),
		BackgroundColor3 = C.PanelHover,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
	}, window)
	corner(list, 12)

	local listOpen = false

	local function setList(open)
		listOpen = open
		list.Visible = open
		tween(chevron, 0.15, { Rotation = open and 180 or 0 })
	end

	for index, provider in ipairs(PROVIDERS) do
		local option = new("TextButton", {
			Position = UDim2.fromOffset(4, 4 + (index - 1) * 40),
			Size = UDim2.new(1, -8, 0, 36),
			BackgroundColor3 = C.PanelHover,
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = provider.Name,
			TextColor3 = C.Text,
			TextSize = 14,
			ZIndex = 21,
		}, list)
		corner(option, 10)
		option.MouseEnter:Connect(function()
			tween(option, 0.12, { BackgroundColor3 = Color3.fromRGB(46, 46, 46) })
		end)
		option.MouseLeave:Connect(function()
			tween(option, 0.12, { BackgroundColor3 = C.PanelHover })
		end)
		option.Activated:Connect(function()
			setList(false)
			if copyText(provider.Url) then
				setStatus("Key link copied. Open it in your browser, then paste your key here.", C.Accent)
			else
				setStatus("Copy this link manually: " .. provider.Url, C.Error)
			end
		end)
	end

	dropdown.Activated:Connect(function()
		setList(not listOpen)
	end)

	local submitting = false
	local function submit()
		if submitting then return end
		submitting = true
		setStatus("Checking key...", C.Sub)

		local ok, result = validateKey(keyBox.Text)
		if not ok then
			setStatus(result, C.Error)
			submitting = false
			return
		end

		setStatus("Key accepted. Loading...", C.Accent)
		task.wait(0.3)
		gui:Destroy()
		buildHub()
	end

	redeem.Activated:Connect(submit)
	keyBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)

	local function faqLabel(text, y, height, size, font, color)
		return new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(408, y),
			Size = UDim2.fromOffset(360, height),
			Font = font,
			Text = text,
			TextColor3 = color,
			TextSize = size,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, window)
	end

	faqLabel("FAQ", 88, 24, 17, Enum.Font.GothamBold, C.Text)
	faqLabel("Is this script free?", 124, 18, 13, Enum.Font.GothamBold, C.Accent)
	faqLabel(
		"Yes. Press Get Key, choose a provider, and tap it to copy the link. Open that link in your browser, copy the key you receive, then paste it here.",
		146,
		52,
		12,
		Enum.Font.Gotham,
		C.Answer
	)
	faqLabel("How long does a key last?", 206, 18, 13, Enum.Font.GothamBold, C.Accent)
	faqLabel(
		describeDuration(KEY_LIFETIME) .. ". When it expires, press Get Key again to get a new one. Need help? Join our Discord.",
		228,
		36,
		12,
		Enum.Font.Gotham,
		C.Answer
	)

	local discord = makeButton("Join Discord", UDim2.fromOffset(408, 268), UDim2.fromOffset(360, 46), true)
	discord.Activated:Connect(function()
		if copyText(DISCORD_URL) then
			setStatus("Discord invite copied. Paste it in your browser.", C.Accent)
		else
			setStatus("Copy this invite manually: " .. DISCORD_URL, C.Error)
		end
	end)
end

buildKeySystem()
