local function resolveIcon(name)
	for _, alias in ipairs(ALIASES[name] or { name }) do
		if FootagesusIcons and FootagesusIcons.Icon then
			local ok, data = pcall(FootagesusIcons.Icon, alias)
			if ok and data then
				if type(data) == "string" then
					return { Image = data }
				elseif type(data) == "table" then
					local image = data[1] or data.Image or data.id
					local info = type(data[2]) == "table" and data[2] or data
					if image then
						if type(image) == "number" then
							image = "rbxassetid://" .. image
						end
						return {
							Image = image,
							Offset = info.ImageRectPosition or info.ImageRectOffset or info.imageRectOffset,
							Size = info.ImageRectSize or info.imageRectSize,
						}
					end
				end
			end
		end
		if RayfieldIcons then
			local ok, entry = pcall(function()
				return RayfieldIcons["48px"][alias]
			end)
			if ok and type(entry) == "table" and entry[1] and entry[2] and entry[3] then
				return {
					Image = "rbxassetid://" .. entry[1],
					Size = Vector2.new(entry[2][1], entry[2][2]),
					Offset = Vector2.new(entry[3][1], entry[3][2]),
				}
			end
		end
	end
end

local function makeIcon(parent, name, size, color, position, anchor)
	local img = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = position or UDim2.new(),
		AnchorPoint = anchor or Vector2.new(),
		ImageColor3 = color or C.Text,
	}, parent)

	local data = resolveIcon(name)
	if data then
		img.Image = data.Image
		if data.Offset then
			img.ImageRectOffset = data.Offset
		end
		if data.Size then
			img.ImageRectSize = data.Size
		end
	else
		new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamBold,
			Text = FALLBACK[name] or "?",
			TextColor3 = color or C.Text,
			TextSize = math.max(10, size - 4),
		}, img)
	end

	return img
end

local function describeDuration(seconds)
	if seconds >= 3600 then
		local hours = math.floor(seconds / 3600)
		return hours .. (hours == 1 and " hour" or " hours")
	elseif seconds >= 60 then
		local minutes = math.floor(seconds / 60)
		return minutes .. (minutes == 1 and " minute" or " minutes")
	end
	return seconds .. (seconds == 1 and " second" or " seconds")
end

local function httpGet(url)
	if request then
		local res = request({ Url = url, Method = "GET" })
		return res.Body, res.StatusCode
	end
	return game:HttpGet(url), 200
end

local function validateKey(text)
	local key = (tostring(text):gsub("%s+", "")):upper()
	if key == "" then
		return false, "Enter your key first."
	end
	local ok, body = pcall(httpGet, SERVER .. "/validate?key=" .. HttpService:UrlEncode(key))
	if not ok then
		return false, "Could not reach the key server."
	end
	local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, body)
	if not decodeOk then
		return false, "Could not reach the key server."
	end
	if data.valid then
		return true, key
	end
	return false, data.message or "That key is not valid."
end

